#!/usr/bin/env bash
# Enabled with: git config core.hooksPath .githooks
# On every push: refuses ROMs, game assets and large files (scripts/check-no-roms.sh, PROD-14).
# On a push of main: says what scripts/release-check.sh recommends, then pushes. It does not
# release: a release needs the AppImage and its assets, which `/release` builds and attaches.
# Skip the release note with NO_RELEASE_CHECK=1. `git push --no-verify` skips the whole hook.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

pushes_main=0
zero=0000000000000000000000000000000000000000
while read -r _ local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] && pushes_main=1
  [ "$local_sha" = "$zero" ] && continue
  # A remote commit we do not have (a forced push after the remote moved) cannot make a
  # range: check everything no remote-tracking ref has instead.
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range=("$remote_sha..$local_sha")
  else
    range=("$local_sha" --not --remotes)
  fi
  scripts/check-no-roms.sh "${range[@]}" || exit 1
done

[ "$pushes_main" = 1 ] && [ -z "${NO_RELEASE_CHECK:-}" ] || exit 0

mapfile -t check < <(scripts/release-check.sh HEAD)
level=${check[0]:-none}
if [ "$level" != none ]; then
  echo "pre-push: the commits since the last release suggest a $level release:" >&2
  printf '  %s\n' "${check[@]:1}" >&2
  echo "pre-push: run /release to build the AppImage and publish it" >&2
fi
exit 0
